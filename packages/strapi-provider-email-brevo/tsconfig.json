{
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": false,
    "composite": false,
    "module": "NodeNext",
    "target": "ES2019",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
} 