{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Crowdfunding projects"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title",
      "required": false
    },
    "Description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "ShortDescription": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "maxLength": 160
    },
    "Type": {
      "type": "enumeration",
      "required": true,
      "default": "give",
      "enum": [
        "give",
        "back"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "Category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "Projects"
    },
    "ProjectStatus": {
      "type": "enumeration",
      "required": true,
      "default": "draft",
      "enum": [
        "draft",
        "active",
        "funded",
        "ended",
        "cancelled"
      ]
    },
    "FundingGoal": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "CurrentFunding": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "Currency": {
      "type": "enumeration",
      "required": true,
      "default": "USD",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "VND"
      ]
    },
    "BackersCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "GoalMilestones": {
      "type": "component",
      "component": "project.goal-milestone",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "EnableStretchGoals": {
      "type": "boolean",
      "default": false
    },
    "StretchGoal": {
      "type": "decimal",
      "min": 0
    },
    "ShowProgressBar": {
      "type": "boolean",
      "default": true
    },
    "ShowBackersCount": {
      "type": "boolean",
      "default": true
    },
    "ShowTimeRemaining": {
      "type": "boolean",
      "default": true
    },
    "MinimumDonation": {
      "type": "decimal",
      "default": 1,
      "min": 0
    },
    "StartDate": {
      "type": "datetime",
      "required": true
    },
    "EndDate": {
      "type": "datetime",
      "required": true
    },
    "Featured": {
      "type": "boolean",
      "default": false
    },
    "Media": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "MediaURL": {
      "type": "component",
      "component": "utilities.video-url",
      "repeatable": true,
      "required": false
    },
    "Creator": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "Projects"
    },
    "Tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "mappedBy": "Projects"
    },
    "Rewards": {
      "type": "component",
      "component": "project.reward",
      "repeatable": true
    },
    "Updates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project-update.project-update",
      "mappedBy": "Project"
    },
    "Donations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::donation.donation",
      "mappedBy": "Project"
    },
    "Comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "Project"
    },
    "Seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
