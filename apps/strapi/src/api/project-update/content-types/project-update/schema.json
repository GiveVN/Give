{
  "kind": "collectionType",
  "collectionName": "project_updates",
  "info": {
    "singularName": "project-update",
    "pluralName": "project-updates",
    "displayName": "Project Update",
    "description": "Updates and announcements from project owners to supporters"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Content": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Excerpt": {
      "type": "text",
      "maxLength": 300
    },
    "Images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "IsPublic": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "IsPinned": {
      "type": "boolean",
      "default": false
    },
    "ViewCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "Project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "Updates"
    },
    "Author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "ProjectUpdates"
    },
    "Comments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::comment.comment",
      "mappedBy": "ProjectUpdate"
    }
  }
}
