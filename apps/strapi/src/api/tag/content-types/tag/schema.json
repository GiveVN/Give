{
  "kind": "collectionType",
  "collectionName": "tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag",
    "description": "Tags for project categorization"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "Name": {
      "type": "string",
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "Slug": {
      "type": "uid",
      "targetField": "Name",
      "required": true
    },
    "Color": {
      "type": "enumeration",
      "enum": [
        "blue",
        "green",
        "red",
        "yellow",
        "purple",
        "pink",
        "indigo",
        "gray"
      ],
      "default": "blue"
    },
    "Projects": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::project.project",
      "inversedBy": "Tags"
    }
  }
}
