{
  "kind": "collectionType",
  "collectionName": "donations",
  "info": {
    "singularName": "donation",
    "pluralName": "donations",
    "displayName": "Donation",
    "description": "Donations from Givers to Projects on Give platform"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "Amount": {
      "type": "decimal",
      "required": true,
      "min": 0.01
    },
    "Currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "EUR",
        "VND",
        "ETH",
        "BTC"
      ],
      "default": "USD",
      "required": true
    },
    "PaymentMethod": {
      "type": "enumeration",
      "enum": [
        "stripe",
        "paypal",
        "crypto"
      ],
      "required": true
    },
    "PaymentId": {
      "type": "string",
      "required": true
    },
    "PaymentStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending",
      "required": true
    },
    "IsAnonymous": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "GiverName": {
      "type": "string",
      "maxLength": 100
    },
    "Message": {
      "type": "text",
      "maxLength": 500
    },
    "Project": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project",
      "inversedBy": "Donations"
    },
    "Giver": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "Donations"
    }
  }
}
