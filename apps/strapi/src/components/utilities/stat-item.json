{
  "collectionName": "components_utilities_stat_items",
  "info": {
    "displayName": "Stat Item",
    "description": "Individual statistic item with title, value, and change percentage"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "value": {
      "type": "string",
      "required": true
    },
    "change": {
      "type": "string",
      "required": false
    },
    "changeType": {
      "type": "enumeration",
      "enum": ["positive", "negative", "neutral"],
      "default": "positive"
    }
  }
} 