{
  "collectionName": "components_project_rewards",
  "info": {
    "displayName": "Reward",
    "description": "Project reward/perk for backers"
  },
  "options": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true,
      "maxLength": 100
    },
    "Description": {
      "type": "text",
      "required": true
    },
    "Amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "Currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "EUR",
        "GBP",
        "VND"
      ],
      "default": "USD",
      "required": true
    },
    "EstimatedDelivery": {
      "type": "date"
    },
    "LimitedQuantity": {
      "type": "integer",
      "min": 0
    },
    "ClaimedQuantity": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "IsActive": {
      "type": "boolean",
      "default": true
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
} 