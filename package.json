{
  "name": "Give-Crowdfunding",
  "version": "2.0.0",
  "private": true,
  "author": {
    "name": "JOY",
    "email": "h@joy.box",
    "url": "https://joy.box"
  },
  "maintainers": [
    {
      "name": "JOY",
      "email": "h@joy.box",
      "url": "https://joy.box"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build --cache-dir=.turbo",
    "build:strapi": "turbo run build --filter=@repo/strapi",
    "build:ui": "turbo run build --filter=@repo/ui",
    "commit": "git-cz",
    "predev": "powershell -ExecutionPolicy Bypass -File ./scripts/kill-ports-fixed.ps1",
    "dev": "turbo dev",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-clean.ps1",
    "dev:sequential": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-sequential.ps1",
    "dev:simple": "powershell -ExecutionPolicy Bypass -File ./scripts/dev-simple.ps1",
    "dev:no-turbo": "concurrently \"yarn dev:strapi\" \"yarn dev:ui\"",
    "dev:strapi": "turbo run dev --filter=@repo/strapi",
    "dev:ui": "turbo run dev --filter=@repo/ui",
    "format": "prettier --write --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "format:check": "prettier --check --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "heroku-postbuild": "bash ./scripts/heroku/heroku-postbuild.sh",
    "preinstall": "npx only-allow yarn",
    "secrets:update": "pwsh ./scripts/generate-env.ps1 -TplFile apps/strapi/.env.tpl -OutFile apps/strapi/.env && pwsh ./scripts/generate-env.ps1 -TplFile apps/ui/.env.local.tpl -OutFile apps/ui/.env.local",
    "lint": "turbo lint",
    "prepare": "husky",
    "start:strapi": "turbo run start --filter=@repo/strapi",
    "start:ui": "turbo run start --filter=@repo/ui",
    "setup:apps": "find . -name '*.example' -exec sh -c 'cp \"$1\" \"${1%.example}\"' _ {} \\;"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.2",
    "@repo/eslint-config": "*",
    "@repo/prettier-config": "*",
    "@repo/typescript-config": "*",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.29.0",
    "husky": "^9.1.1",
    "lint-staged": "16.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-packagejson": "^2.5.17",
    "turbo": "^2.5.4"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "22.x.x",
    "yarn": "1.22.x"
  },
  "comments": {
    "prettier": "bump to 3.3.3 destroys types schemas generated by Strapi (@strapi/typescript-utils > generators > utils > prettier.format())"
  },
  "dependencies": {
    "strapi-provider-email-brevo": "file:packages/strapi-provider-email-brevo"
  }
}
